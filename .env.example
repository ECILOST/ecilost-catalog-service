# Copia este archivo a .env y rellena los valores. .env NO se versiona.

NODE_ENV=development
PORT=3001

# El parametro ?schema= aisla este servicio: un esquema por microservicio, sin joins cruzados.
# 5434 es el puerto que expone docker-compose.yml; 5433 ya lo ocupa ecilost-auth-service.
DATABASE_URL="postgresql://ecilost:ecilost@localhost:5434/ecilost_catalog?schema=catalog"

# Sesion emitida por ecilost-auth-service. Este servicio descarga la llave publica una vez
# y verifica cada access token en local: nunca lo llama por peticion.
# JWT_ISSUER y JWT_AUDIENCE deben coincidir con los del emisor o ningun token verificara.
AUTH_JWKS_URL=http://localhost:3000/.well-known/jwks.json
JWT_ISSUER=https://auth.ecilost.local
JWT_AUDIENCE=ecilost-services

# Almacen de las fotografias y el video (HU-07). En local es el MinIO de docker-compose.yml.
# Estas variables valen para cualquier almacen que hable el protocolo de S3: el mismo MinIO
# desplegado, AWS S3, Cloudflare R2 o DigitalOcean Spaces. Azure Blob Storage no habla S3 y
# pediria un adaptador propio, que es lo que el puerto MediaStorage deja barato.
#
# El endpoint tiene que ser el mismo que alcanza el NAVEGADOR, no solo este proceso: las URL
# de lectura se firman contra el, y una firmada contra un nombre de red interno no resuelve
# desde el cliente. Con MinIO publicado en el host, localhost sirve para los dos.
MEDIA_S3_ENDPOINT=http://localhost:9000
MEDIA_S3_REGION=us-east-1
MEDIA_S3_BUCKET=ecilost-catalog-media
MEDIA_S3_ACCESS_KEY=ecilost
MEDIA_S3_SECRET_KEY=ecilostsecret
