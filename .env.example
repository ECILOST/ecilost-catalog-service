# Copia este archivo a .env y rellena los valores. .env NO se versiona.

NODE_ENV=development
PORT=3001

# El parametro ?schema= aisla este servicio: un esquema por microservicio, sin joins cruzados.
# 5434 es el puerto que expone docker-compose.yml; 5433 ya lo ocupa ecilost-auth-service.
DATABASE_URL="postgresql://ecilost:ecilost@localhost:5434/ecilost_catalog?schema=catalog"

# Sesion emitida por ecilost-auth-service. Este servicio descarga la llave publica una vez
# y verifica cada access token en local: nunca lo llama por peticion.
# JWT_ISSUER y JWT_AUDIENCE deben coincidir con los del emisor o ningun token verificara.
AUTH_JWKS_URL=http://localhost:3000/.well-known/jwks.json
JWT_ISSUER=https://auth.ecilost.local
JWT_AUDIENCE=ecilost-services
